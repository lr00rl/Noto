{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noto.invalid/bridge-protocol/v1/protocol.schema.json",
  "title": "Noto bridge protocol v1",
  "type": "object",
  "required": ["protocolVersion", "type", "requestId", "sessionId", "sessionGeneration", "revision", "payload"],
  "properties": {
    "protocolVersion": { "const": 1 },
    "type": {
      "enum": [
        "editor.ready", "editor.delta", "editor.checkpoint",
        "document.open", "document.snapshot.request", "document.snapshot.response",
        "document.saved", "document.saveFailed", "document.externalChange",
        "theme.set", "chunk.begin", "chunk.data", "chunk.ack", "chunk.end", "error"
      ]
    },
    "requestId": { "$ref": "#/$defs/uuid" },
    "sessionId": { "$ref": "#/$defs/uuid" },
    "sessionGeneration": { "type": "integer", "minimum": 1 },
    "revision": { "type": "integer", "minimum": 0 },
    "payload": { "type": "object" }
  },
  "allOf": [
    { "if": { "properties": { "type": { "const": "editor.ready" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/editorReady" } } } },
    { "if": { "properties": { "type": { "const": "editor.delta" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/editorDelta" } } } },
    { "if": { "properties": { "type": { "const": "editor.checkpoint" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/checkpoint" } } } },
    { "if": { "properties": { "type": { "const": "document.open" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/transferReference" } } } },
    { "if": { "properties": { "type": { "const": "document.snapshot.request" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/snapshotRequest" } } } },
    { "if": { "properties": { "type": { "const": "document.snapshot.response" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/transferReference" } } } },
    { "if": { "properties": { "type": { "const": "document.saved" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/saved" } } } },
    { "if": { "properties": { "type": { "const": "document.saveFailed" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/failure" } } } },
    { "if": { "properties": { "type": { "const": "document.externalChange" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/externalChange" } } } },
    { "if": { "properties": { "type": { "const": "theme.set" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/theme" } } } },
    { "if": { "properties": { "type": { "const": "chunk.begin" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/chunkBegin" } } } },
    { "if": { "properties": { "type": { "const": "chunk.data" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/chunkData" } } } },
    { "if": { "properties": { "type": { "const": "chunk.ack" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/chunkAck" } } } },
    { "if": { "properties": { "type": { "const": "chunk.end" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/chunkEnd" } } } },
    { "if": { "properties": { "type": { "const": "error" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/failure" } } } }
  ],
  "additionalProperties": false,
  "$defs": {
    "uuid": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "closed": { "type": "object", "additionalProperties": false },
    "editorReady": { "type": "object", "required": ["capabilities"], "properties": { "capabilities": { "type": "array", "items": { "type": "string" }, "uniqueItems": true } }, "additionalProperties": false },
    "editorDelta": { "type": "object", "required": ["transactionId", "fromRevision", "toRevision", "utf8ByteLength", "sha256"], "properties": { "transactionId": { "$ref": "#/$defs/uuid" }, "fromRevision": { "type": "integer", "minimum": 0 }, "toRevision": { "type": "integer", "minimum": 1 }, "utf8ByteLength": { "type": "integer", "minimum": 0, "maximum": 16777216 }, "sha256": { "$ref": "#/$defs/sha256" } }, "additionalProperties": false },
    "checkpoint": { "type": "object", "required": ["transferId", "utf8ByteLength", "sha256"], "properties": { "transferId": { "$ref": "#/$defs/uuid" }, "utf8ByteLength": { "type": "integer", "minimum": 0, "maximum": 16777216 }, "sha256": { "$ref": "#/$defs/sha256" } }, "additionalProperties": false },
    "transferReference": { "type": "object", "required": ["transferId", "utf8ByteLength", "sha256"], "properties": { "transferId": { "$ref": "#/$defs/uuid" }, "utf8ByteLength": { "type": "integer", "minimum": 0, "maximum": 16777216 }, "sha256": { "$ref": "#/$defs/sha256" } }, "additionalProperties": false },
    "snapshotRequest": { "type": "object", "required": ["frozenRevision"], "properties": { "frozenRevision": { "type": "integer", "minimum": 0 } }, "additionalProperties": false },
    "saved": { "type": "object", "required": ["durableRevision", "sha256"], "properties": { "durableRevision": { "type": "integer", "minimum": 0 }, "sha256": { "$ref": "#/$defs/sha256" } }, "additionalProperties": false },
    "failure": { "type": "object", "required": ["code", "message"], "properties": { "code": { "type": "string", "minLength": 1 }, "message": { "type": "string", "minLength": 1 }, "retryable": { "type": "boolean" } }, "additionalProperties": false },
    "externalChange": { "type": "object", "required": ["kind"], "properties": { "kind": { "enum": ["modified", "moved", "deleted", "permissionLost"] } }, "additionalProperties": false },
    "theme": { "type": "object", "required": ["appearance"], "properties": { "appearance": { "enum": ["light", "dark"] } }, "additionalProperties": false },
    "chunkBegin": { "type": "object", "required": ["transferId", "purpose", "totalBytes", "chunkBytes", "totalChunks", "sha256", "timeoutMs"], "properties": { "transferId": { "$ref": "#/$defs/uuid" }, "purpose": { "enum": ["document.open", "document.snapshot.response", "editor.checkpoint"] }, "totalBytes": { "type": "integer", "minimum": 0, "maximum": 16777216 }, "chunkBytes": { "type": "integer", "minimum": 262144, "maximum": 524288 }, "totalChunks": { "type": "integer", "minimum": 1, "maximum": 64 }, "sha256": { "$ref": "#/$defs/sha256" }, "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 60000 } }, "additionalProperties": false },
    "chunkData": { "type": "object", "required": ["transferId", "index", "byteLength", "dataBase64"], "properties": { "transferId": { "$ref": "#/$defs/uuid" }, "index": { "type": "integer", "minimum": 0, "maximum": 63 }, "byteLength": { "type": "integer", "minimum": 0, "maximum": 524288 }, "dataBase64": { "type": "string" } }, "additionalProperties": false },
    "chunkAck": { "type": "object", "required": ["transferId", "ackedThrough"], "properties": { "transferId": { "$ref": "#/$defs/uuid" }, "ackedThrough": { "type": "integer", "minimum": 0, "maximum": 63 } }, "additionalProperties": false },
    "chunkEnd": { "type": "object", "required": ["transferId", "totalBytes", "totalChunks", "sha256"], "properties": { "transferId": { "$ref": "#/$defs/uuid" }, "totalBytes": { "type": "integer", "minimum": 0, "maximum": 16777216 }, "totalChunks": { "type": "integer", "minimum": 1, "maximum": 64 }, "sha256": { "$ref": "#/$defs/sha256" } }, "additionalProperties": false }
  }
}

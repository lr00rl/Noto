{
  "name": "@noto/web-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "licenses": "node scripts/generate-license-inventory.mjs",
    "lint": "eslint src tests scripts",
    "test": "node scripts/build.mjs && node ../Tests/ProtocolContracts/validate-fixtures.mjs && node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm test && pnpm run build && pnpm run licenses"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.3.4",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.43.6",
    "codemirror": "^6.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@types/node": "^24.0.15",
    "esbuild": "^0.25.8",
    "eslint": "^9.31.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0"
  },
  "engines": {
    "node": ">=22"
  }
}

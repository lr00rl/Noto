{
  "cases": [
    {
      "name": "paragraph-soft-break",
      "source": "中文 paragraph\nsoft line",
      "expected": [
        { "kind": "paragraph", "from": 0, "to": 22, "markers": [], "roles": ["prose"] }
      ]
    },
    {
      "name": "hard-break-trailing-spaces",
      "source": "line  \nnext",
      "expected": [
        { "kind": "hardBreak", "from": 4, "to": 7, "markers": [[4, 6, "hard-break"]], "roles": ["hard-break"] }
      ]
    },
    {
      "name": "hard-break-backslash",
      "source": "line\\\nnext",
      "expected": [
        { "kind": "hardBreak", "from": 4, "to": 6, "markers": [[4, 5, "hard-break"]], "roles": ["hard-break"] }
      ]
    },
    {
      "name": "atx-heading-with-closing-run",
      "source": "# Heading #",
      "expected": [
        { "kind": "heading", "from": 0, "to": 11, "markers": [[0, 2, "heading-prefix"], [9, 11, "heading-suffix"]], "roles": ["heading", "heading-1"] }
      ]
    },
    {
      "name": "asterisk-emphasis",
      "source": "*emphasis*",
      "expected": [
        { "kind": "emphasis", "from": 0, "to": 10, "markers": [[0, 1, "emphasis-open"], [9, 10, "emphasis-close"]], "roles": ["emphasis"] }
      ]
    },
    {
      "name": "underscore-strong",
      "source": "__strong__",
      "expected": [
        { "kind": "strong", "from": 0, "to": 10, "markers": [[0, 2, "strong-open"], [8, 10, "strong-close"]], "roles": ["strong"] }
      ]
    },
    {
      "name": "inline-code",
      "source": "`code`",
      "expected": [
        { "kind": "inlineCode", "from": 0, "to": 6, "markers": [[0, 1, "code-open"], [5, 6, "code-close"]], "roles": ["inline-code"] }
      ]
    },
    {
      "name": "inline-link-with-title",
      "source": "[label](dest \"title\")",
      "expected": [
        { "kind": "link", "from": 0, "to": 21, "markers": [[0, 1, "link-open"], [6, 21, "link-target"]], "roles": ["link"] }
      ]
    },
    {
      "name": "bullet-list-item",
      "source": "- item",
      "expected": [
        { "kind": "listItem", "from": 0, "to": 6, "markers": [[0, 1, "bullet-marker"]], "roles": ["list-item", "bullet-list-item"] }
      ]
    },
    {
      "name": "ordered-list-item",
      "source": "12) item",
      "expected": [
        { "kind": "listItem", "from": 0, "to": 8, "markers": [[2, 3, "ordered-delimiter"]], "roles": ["list-item", "ordered-list-item"] }
      ]
    },
    {
      "name": "block-quote-multiple-lines",
      "source": "> quote\n> line",
      "expected": [
        { "kind": "blockQuote", "from": 0, "to": 14, "markers": [[0, 2, "quote-prefix"], [8, 10, "quote-prefix"]], "roles": ["block-quote"] }
      ]
    },
    {
      "name": "thematic-break",
      "source": "***",
      "expected": [
        { "kind": "thematicBreak", "from": 0, "to": 3, "markers": [[0, 3, "thematic-break"]], "roles": ["thematic-break"] }
      ]
    },
    {
      "name": "fenced-code-with-info",
      "source": "```ts\nconst x = 1\n```",
      "expected": [
        { "kind": "fencedCode", "from": 0, "to": 21, "markers": [[0, 5, "code-fence-open"], [18, 21, "code-fence-close"]], "roles": ["fenced-code"] }
      ]
    },
    {
      "name": "nested-inline-constructs",
      "source": "**bold *inner* tail** and [*label*](dest)",
      "expected": [
        { "kind": "strong", "from": 0, "to": 21, "markers": [[0, 2, "strong-open"], [19, 21, "strong-close"]], "roles": ["strong"] },
        { "kind": "emphasis", "from": 7, "to": 14, "markers": [[7, 8, "emphasis-open"], [13, 14, "emphasis-close"]], "roles": ["emphasis"] },
        { "kind": "link", "from": 26, "to": 41, "markers": [[26, 27, "link-open"], [34, 41, "link-target"]], "roles": ["link"] },
        { "kind": "emphasis", "from": 27, "to": 34, "markers": [[27, 28, "emphasis-open"], [33, 34, "emphasis-close"]], "roles": ["emphasis"] }
      ]
    },
    {
      "name": "empty-boundaries",
      "source": "# \n\n` `\n\n[](dest)\n\n```\n```",
      "expected": [
        { "kind": "heading", "from": 0, "to": 2, "markers": [[0, 2, "heading-prefix"]], "roles": ["heading", "heading-1"] },
        { "kind": "inlineCode", "from": 4, "to": 7, "markers": [[4, 5, "code-open"], [6, 7, "code-close"]], "roles": ["inline-code"] },
        { "kind": "link", "from": 9, "to": 17, "markers": [[9, 10, "link-open"], [10, 17, "link-target"]], "roles": ["link"] },
        { "kind": "fencedCode", "from": 19, "to": 26, "markers": [[19, 22, "code-fence-open"], [23, 26, "code-fence-close"]], "roles": ["fenced-code"] }
      ]
    }
  ],
  "fallbackCases": [
    {
      "name": "malformed-markdown",
      "source": "*unclosed\n\n[link](\n\n```ts\nunclosed",
      "forbiddenKinds": ["emphasis", "link", "fencedCode"]
    },
    {
      "name": "deferred-markdown",
      "source": "- [ ] task\n\n~~strike~~\n\n<https://example.com>\n\n![alt](image.png)\n\n| a | b |\n| - | - |\n\n<div>x</div>\n\n[^1]\n\n$$x$$\n\n[[wiki]]\n\n::: box\n:::",
      "forbiddenKinds": ["listItem", "emphasis", "strong", "link"]
    },
    {
      "name": "front-matter",
      "source": "---\ntitle: v\n---",
      "forbiddenKinds": ["thematicBreak", "heading"]
    }
  ]
}
